{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meta-gray-label",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_BASE_URL": ""
  }
}
