{
  "name": "Meta Grey Label WordPress",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "Meta Grey Label WordPress",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-wordpress.sh",
  "remoteUser": "node"
}
