{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "brand",
          "name": "Brand Green",
          "color": "#00d094"
        },
        {
          "slug": "ink",
          "name": "Dark Ink",
          "color": "#0c263a"
        },
        {
          "slug": "deep",
          "name": "Deep Teal",
          "color": "#061f2d"
        },
        {
          "slug": "surface",
          "name": "Light Surface",
          "color": "#f7fbfa"
        },
        {
          "slug": "light",
          "name": "White",
          "color": "#ffffff"
        },
        {
          "slug": "muted",
          "name": "Muted Text",
          "color": "#52656d"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.125rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.65rem"
        },
        {
          "slug": "x-large",
          "name": "Display",
          "size": "clamp(2.35rem, 4.5vw, 4.8rem)"
        }
      ],
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System UI",
          "fontFamily": "ui-sans-serif, system-ui, -apple-system, sans-serif"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "0.5rem"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "1rem"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "2rem"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "3.5rem"
        },
        {
          "slug": "xl",
          "name": "Extra Large",
          "size": "6rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#f7fbfa",
      "text": "#0c263a"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#008f72"
        }
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.6"
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Site header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site footer",
      "area": "footer"
    },
    {
      "name": "header-native",
      "title": "Editable native header",
      "area": "header"
    },
    {
      "name": "footer-native",
      "title": "Editable native footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-native",
      "title": "Meta Grey Label — Editable Native Blocks",
      "postTypes": [
        "page"
      ]
    }
  ]
}
