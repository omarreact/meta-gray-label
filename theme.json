{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1210px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "brand",
          "name": "Brand Green",
          "color": "#00d094"
        },
        {
          "slug": "ink",
          "name": "Dark Ink",
          "color": "#0c263a"
        },
        {
          "slug": "deep",
          "name": "Deep Teal",
          "color": "#061f2d"
        },
        {
          "slug": "surface",
          "name": "Light Surface",
          "color": "#f7fbfa"
        },
        {
          "slug": "light",
          "name": "White",
          "color": "#ffffff"
        },
        {
          "slug": "muted",
          "name": "Muted Text",
          "color": "#52656d"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "clamp(0.875rem, 0.84rem + 0.17vw, 1.0625rem)"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 1.08rem + 0.75vw, 2rem)"
        },
        {
          "slug": "x-large",
          "name": "Display",
          "size": "clamp(2.417625rem, 4.8vw, 4.5rem)"
        }
      ],
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "\"Inter\", ui-sans-serif, sans-serif"
        },
        {
          "slug": "poppins",
          "name": "Poppins",
          "fontFamily": "\"Poppins\", ui-sans-serif, sans-serif"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "8px"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "16px"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "24px"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "48px"
        },
        {
          "slug": "xl",
          "name": "Extra Large",
          "size": "72px"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#10282d",
      "text": "#f3f8f7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#68e7c5"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--poppins)",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-0.05em"
        }
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "lineHeight": "1.75",
      "fontSize": "clamp(0.875rem, 0.84rem + 0.17vw, 1.0625rem)"
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Site header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site footer",
      "area": "footer"
    }
  ]
}
