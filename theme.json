{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1210px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "brand",
          "name": "Brand Green",
          "color": "#00d094"
        },
        {
          "slug": "ink",
          "name": "Dark Ink",
          "color": "#0c263a"
        },
        {
          "slug": "deep",
          "name": "Deep Teal",
          "color": "#061f2d"
        },
        {
          "slug": "surface",
          "name": "Light Surface",
          "color": "#f7fbfa"
        },
        {
          "slug": "light",
          "name": "White",
          "color": "#ffffff"
        },
        {
          "slug": "muted",
          "name": "Muted Text",
          "color": "#52656d"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "12px"
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "13px"
        },
        {
          "slug": "sm",
          "name": "Small UI",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Body",
          "size": "clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.337), 17px)"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.674), 20px)"
        },
        {
          "slug": "lg",
          "name": "Lead",
          "size": "clamp(15.197px, 0.95rem + ((1vw - 3.2px) * 0.877), 23px)"
        },
        {
          "slug": "xl",
          "name": "Heading",
          "size": "clamp(20px, 1.25rem + ((1vw - 3.2px) * 1.348), 32px)"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(22.041px, 1.378rem + ((1vw - 3.2px) * 1.568), 36px)"
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "clamp(25.014px, 1.563rem + ((1vw - 3.2px) * 1.909), 42px)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(38.682px, 2.418rem + ((1vw - 3.2px) * 3.744), 72px)"
        }
      ],
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Arial / Helvetica",
          "fontFamily": "Arial, Helvetica, sans-serif"
        },
        {
          "slug": "display",
          "name": "Arial / Helvetica",
          "fontFamily": "Arial, Helvetica, sans-serif"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "8px"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "16px"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "24px"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "48px"
        },
        {
          "slug": "xl",
          "name": "Extra Large",
          "size": "72px"
        }
      ]
    },
    "custom": {
      "mglInner": {
        "container": "1180px",
        "radius": "12px",
        "motion": "cubic-bezier(.22,1,.36,1)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "#10282d",
      "text": "#f3f8f7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#68e7c5"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontStyle": "normal",
          "fontWeight": "600",
          "lineHeight": "1.04",
          "letterSpacing": "-0.065em"
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "14px",
          "fontWeight": "800",
          "lineHeight": "1.2",
          "letterSpacing": "normal"
        }
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "fontStyle": "normal",
      "fontWeight": "400",
      "lineHeight": "1.75"
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "14px",
          "fontWeight": "600",
          "lineHeight": "1.5",
          "letterSpacing": "normal"
        }
      },
      "core/button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "14px",
          "fontWeight": "800",
          "lineHeight": "1.2",
          "letterSpacing": "normal"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Site header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site footer",
      "area": "footer"
    }
  ]
}
